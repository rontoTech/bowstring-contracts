# Deployer private key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Protocol treasury address (defaults to deployer if not set)
TREASURY_ADDRESS=0x...

# Robinhood Chain Testnet RPC (Alchemy recommended)
RPC_URL=https://robinhood-testnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Block explorer API key (for contract verification)
ETHERSCAN_API_KEY=your_api_key
